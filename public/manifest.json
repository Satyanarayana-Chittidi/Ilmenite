{
  "manifest_version": 3,
  "version": "1.2.9",
  "name": "Ilmenite",
  "description": "Provides in-browser Monaco IDE, custom testcases, snippets, autocomplete, cloud sync, and customizable dark theme for Codeforces",
  "author": "Chittidi Satyanarayana",
  "short_name": "Ilmenite",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": ["https://codeforces.com/*", "https://www.onlinegdb.com/*"],
  "externally_connectable": {
    "matches": [
      "https://ilmenite.vercel.app/*",
      "https://ilmenite.app/*",
      "https://*.ilmenite.app/*",
      "http://localhost/*",
      "http://localhost:5000/*",
      "http://localhost:5500/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*",
      "http://localhost:8080/*",
      "http://127.0.0.1/*",
      "http://127.0.0.1:5000/*",
      "http://127.0.0.1:5500/*",
      "http://127.0.0.1:3000/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:8080/*"
    ]
  },
  "icons": {
    "128": "assets/icons/ilmenite_icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "*.js", "*.worker.js", "assets/*"],
      "matches": ["https://codeforces.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "background": {
    "service_worker": "assets/scripts/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/*"],
      "exclude_matches": ["https://codeforces.com/api/*"],
      "all_frames": true,
      "css": ["assets/styles/inject-styles.css"],
      "js": [
        "assets/scripts/content.js",
        "assets/scripts/changeUIFunctions/loginPageChanges.js",
        "assets/scripts/changeUIFunctions/problemSetPageChanges.js",
        "assets/scripts/darkModeFunctions/darkMode.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://codeforces.com/*"
      ],
      "exclude_matches": [
        "https://codeforces.com/api/*"
      ],
      "js": [
        "assets/scripts/iframeInject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ilmenite.vercel.app/*",
        "https://ilmenite.app/*",
        "https://*.ilmenite.app/*",
        "http://localhost/*",
        "http://localhost:5000/*",
        "http://localhost:5500/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost:8080/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:5000/*",
        "http://127.0.0.1:5500/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "assets/scripts/landingSync.js"
      ],
      "run_at": "document_start"
    }
  ]
}
