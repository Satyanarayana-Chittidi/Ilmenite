{
    "name": "ilmenite",
    "private": true,
    "version": "1.2.6",
    "description": "Provides in-browser Monaco IDE, custom testcases, snippets, autocomplete, cloud sync, and customizable dark theme for Codeforces",
    "type": "module",
    "scripts": {
        "start": "webpack serve --mode development",
        "build": "npm run build:chrome",
        "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode production",
        "build:dev:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development",
        "build:dev": "npm run build:dev:chrome",
        "package": "npm run build && npm run zip",
        "zip": "npm run zip:chrome",
        "zip:source": "bestzip extension-releases/ilmenite-source-v%npm_package_version%.zip \"**\" \"!node_modules/**\" \"!dist/**\" \"!extension-releases/**\" \"!.git/**\"",
        "ensure-releases-dir": "node -e \"const fs=require('fs'); if(!fs.existsSync('./extension-releases')){fs.mkdirSync('./extension-releases');}\"",
        "zip:chrome": "npm run ensure-releases-dir && cd dist && bestzip ../extension-releases/ilmenite-chrome-v%npm_package_version%.zip *"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.110.7",
        "@types/chrome": "^0.0.272",
        "framer-motion": "^11.11.8",
        "lucide-react": "^0.447.0",
        "monaco-editor": "^0.52.2",
        "monaco-vim": "^0.4.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sonner": "^1.5.0",
        "zustand": "^5.0.1"
    },
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-react": "^7.26.3",
        "@babel/preset-typescript": "^7.27.0",
        "@eslint/js": "^9.9.0",
        "@types/copy-webpack-plugin": "^8.0.1",
        "@types/html-webpack-plugin": "^3.2.9",
        "@types/node": "^22.15.3",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.3",
        "@types/react-resizable": "^3.0.8",
        "@types/webextension-polyfill": "^0.12.3",
        "@types/webpack": "^5.28.5",
        "autoprefixer": "^10.4.21",
        "babel-loader": "^10.0.0",
        "bestzip": "^2.2.1",
        "copy-webpack-plugin": "^13.0.0",
        "cross-env": "^7.0.3",
        "css-loader": "^7.1.2",
        "eslint": "^9.9.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^15.9.0",
        "html-webpack-plugin": "^5.6.3",
        "monaco-editor-webpack-plugin": "^7.1.0",
        "postcss": "^8.5.3",
        "postcss-loader": "^8.1.1",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.0.1",
        "webpack": "^5.99.6",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.1"
    }
}
